# Copy to .env and change every secret before deploying anywhere real.

# --- Database ---
DB_NAME=blogdb
DB_USER=bloguser
DB_PASSWORD=change-me-to-a-strong-password

# --- Admin login for the CMS (created/updated on every API start) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# --- Signs login tokens. Generate one with: openssl rand -hex 32 ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Web ---
# Host port the site is published on
WEB_PORT=8080
# Allowed browser origins for the API (same-origin through nginx, so you can
# lock this to your domain in production)
CORS_ORIGINS=*
